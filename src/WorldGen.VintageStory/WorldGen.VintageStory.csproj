<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ISRWorldGen</AssemblyName>
    <RootNamespace>ISRWorldGen</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\isrworldgen</OutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorldGen.Core\WorldGen.Core.csproj" />

    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The L00-C client harness stays owned by the test tree.  It is linked
       into the existing mod only for Debug builds so Vintage Story loads no
       second package and Release cannot ship laboratory code. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CMenuActionLabModSystem.cs" Link="L00C\L00CMenuActionLabModSystem.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CMenuActionLaboratoryHost.cs" Link="L00C\L00CMenuActionLaboratoryHost.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CMenuActionDriver.cs" Link="L00C\L00CMenuActionDriver.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CFixtureBootstrap.cs" Link="L00C\L00CFixtureBootstrap.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CCampaignStorage.cs" Link="L00C\L00CCampaignStorage.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CStrictEvidenceJson.cs" Link="L00C\L00CStrictEvidenceJson.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CCampaignInstallFailure.cs" Link="L00C\L00CCampaignInstallFailure.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CProcessCampaignController.cs" Link="L00C\L00CProcessCampaignController.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CManagerLeaseLifecycle.cs" Link="L00C\L00CManagerLeaseLifecycle.cs" />
    <Compile Include="..\..\testsrc\WorldGen.Tests\L00C\L00CNativeFixtureOracle.cs" Link="L00C\L00CNativeFixtureOracle.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="worldconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateVintageStoryInstallation" BeforeTargets="ResolveReferences">
    <Error Condition="'$(VintageStoryPath)' == ''"
           Text="VintageStoryPath is not configured. Copy Directory.Build.local.props.example to Directory.Build.local.props or set VINTAGE_STORY." />
    <Error Condition="!Exists('$(VintageStoryPath)\VintagestoryAPI.dll')"
           Text="VintagestoryAPI.dll was not found under VintageStoryPath '$(VintageStoryPath)'." />
  </Target>

  <Target Name="ValidateRuntimePackage" AfterTargets="Build">
    <Error Condition="!Exists('$(TargetDir)ISRWorldGen.Core.dll')"
           Text="ISRWorldGen.Core.dll must be packaged beside ISRWorldGen.dll." />
  </Target>
</Project>
