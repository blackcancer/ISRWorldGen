<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ISRWorldGen.ClimateHydrology.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <ProjectReference Include="../../src/WorldGen.Core/WorldGen.Core.csproj" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Compile Include="TestAssembly.cs" />
    <!-- Compile the existing climate/drainage tests, not reimplementations or game stubs. -->
    <Compile Include="../WorldGen.Tests/L04A/*.cs" Link="L04A/%(Filename)%(Extension)" />
    <Compile Include="../WorldGen.Tests/L04B/*.cs" Link="L04B/%(Filename)%(Extension)" />
    <Compile Include="../WorldGen.Tests/L04C/*.cs" Link="L04C/%(Filename)%(Extension)" />
    <Compile Include="../WorldGen.Tests/L05A/*.cs" Link="L05A/%(Filename)%(Extension)" />
    <Compile Include="../WorldGen.Tests/L05B/*.cs" Link="L05B/%(Filename)%(Extension)" />
    <Compile Include="../WorldGen.Tests/L05C/*.cs" Link="L05C/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
