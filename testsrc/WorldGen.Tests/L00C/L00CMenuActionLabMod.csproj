<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ISRWorldGen.L00C.MenuActionLab</AssemblyName>
    <RootNamespace>ISRWorldGen.L00C.Laboratory</RootNamespace>
    <OutputPath>..\..\..\.local\L00C\menu-action-testmod\$(Configuration)\isrworldgenl00clab</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefineConstants>$(DefineConstants);L00C_LAB_TESTMOD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Content Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RejectNonDebugLaboratoryBuild" BeforeTargets="Build">
    <Error Condition="'$(Configuration)' != 'Debug'" Text="L00-C menu laboratory mod is Debug-only." />
    <Error Condition="'$(VintageStoryPath)' == '' Or !Exists('$(VintageStoryPath)\VintagestoryAPI.dll')" Text="VintageStoryPath must identify the audited local VintagestoryAPI.dll." />
  </Target>
</Project>
