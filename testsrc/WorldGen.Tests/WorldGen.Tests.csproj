<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ISRWorldGen.Tests</AssemblyName>
    <RootNamespace>ISRWorldGen.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorldGen.Core\WorldGen.Core.csproj" />
    <ProjectReference Include="..\..\src\WorldGen.Runtime\WorldGen.Runtime.csproj" />
    <ProjectReference Include="..\..\src\WorldGen.VintageStory\WorldGen.VintageStory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!-- These sources are linked into ISRWorldGen.dll in Debug only.  The test
       assembly exercises them through the product binary and must not compile
       a duplicate copy. -->
  <ItemGroup>
    <Compile Remove="L00C\L00CMenuActionLabModSystem.cs" />
    <Compile Remove="L00C\L00CMenuActionLaboratoryHost.cs" />
    <Compile Remove="L00C\L00CMenuActionDriver.cs" />
    <Compile Remove="L00C\L00CFixtureBootstrap.cs" />
    <Compile Remove="L00C\L00CProcessCampaignController.cs" />
    <!-- Stand-alone reflection oracle; it supplies its own entry point and is
         invoked by its PowerShell wrapper, not by the MSTest assembly. -->
    <Compile Remove="L00C\L00CClientSessionResolverTests.cs" />
  </ItemGroup>
</Project>
