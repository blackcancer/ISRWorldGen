<Project Sdk="Microsoft.NET.Sdk">
  <!-- This executable links the real barrier but no game assemblies. It does
       not replace the native/MCP qualification or alter production projects. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);L00C_STANDALONE_ORACLE</DefineConstants>
    <BarrierSource Condition="'$(BarrierSource)' == ''">$(MSBuildThisFileDirectory)../../src/WorldGen.VintageStory/WorldgenProbe/L00CLifecycleShutdownBarrier.cs</BarrierSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BarrierSource)" Link="L00CLifecycleShutdownBarrier.cs" />
    <Compile Include="../WorldGen.Tests/L00C/L00CLifecycleShutdownOrderingOracle.cs" Link="L00CLifecycleShutdownOrderingOracle.cs" />
    <Compile Include="../WorldGen.Tests/L00C/L00CLifecycleCommitEvidenceOracle.cs" Link="L00CLifecycleCommitEvidenceOracle.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
