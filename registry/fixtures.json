  "sampling_policy": "256 seeds atlas/bassins ; 16 seeds intégrées au jeu. Les volumes détaillés sont échantillonnés de manière déclarée et reproductible. Augmenter le corpus pour rareté si moins de 100 sites, sans exclure les seeds vides. Les goldens seront produits après audit ; aucun hash de terrain n’est inventé ici.",
  "fixtures": [
    {
      "id": "F01-PLANE",
      "definition": "Grille Core 9×9, z=0..8, x=0..8, h=20−x ; aire de cellule=1 ; seule frontière x=8 ouverte. Sortie connue vers +X."
    },
    {
      "id": "F02-Y",
      "definition": "Nœuds A et B se jettent dans C puis D puis O océan. Apports locaux A=2, B=3, C=1, D=0 ; perte D=1 ; aucun stockage. Q(C)=6, Q(O)=5 en volume modèle/année."
    },
    {
      "id": "F03-DEPRESSION",
      "definition": "Graphe O–S–C, C–A, C–B. Niveaux O=0, S=5, C=3, A=1, B=2. Aires réservoir A=2, B=1, C=1 ; S est un seuil sans aire de stockage. Volume total à niveau 5 : 2×(5−1)+(5−2)+(5−3)=13. A/B fusionnent au seuil 3."
    },
    {
      "id": "F04-ISOLATED-LOWLAND",
      "definition": "Deux cuvettes de même altitude sous SeaLevel ; une reliée par un chenal à frontière marine, l’autre isolée par relief haut. La seconde ne reçoit pas automatiquement de sel."
    },
    {
      "id": "F05-PLATES",
      "definition": "Deux domaines séparés par x=0, normale A→B=(1,0). Mouvement convergent A=(1,0), B=(−1,0), puis divergent inversé et cisaillement A=(0,1), B=(0,−1). Convention de convergence documentée."
    },
    {
      "id": "F06-OROGRAPHY",
      "definition": "Océan côté x minimal, barrière orientée Z, vent +X ; test miroir et test vent −X. Les frontières techniques sont décalées sans déplacer l’orographie."
    },
    {
      "id": "F07-CROSS-REGION",
      "definition": "Primitive courbe traversant deux frontières orthogonales de stockage ; niveau/débit communs connus. Les dimensions de région viennent du profil, non d’une constante du cœur."
    },
    {
      "id": "F08-FLAT-RIVER",
      "definition": "Profil continu descendant de moins d’un bloc sur plusieurs chunks ; lit humide ininterrompu avant quantification. Tester paliers/cascade et frontière dans la portion plate."
    },
    {
      "id": "F09-KARST",
      "definition": "Couche soluble entre deux domaines moins perméables, perte et résurgence avec TransferId commun, deux niveaux fossiles au-dessus du réseau actif."
    },
    {
      "id": "F10-TRAVERSAL",
      "definition": "Galerie normale, porte trop basse, contact diagonal, marche, puits, branche obstruée. Gabarit dimensionné à partir du profil de joueur mesuré dans le jeu ; les attendus sont fixés avant validation."
    },
    {
      "id": "F11-WONDERS",
      "definition": "Mode laboratoire forçant chacun des 5 thèmes en 3 variantes. Interdit d’utiliser ces occurrences forcées pour mesurer la rareté de production."
    },
    {
      "id": "F12-OBSTRUCTION",
      "definition": "Unique route galerie→site, puis décoration/structure dans le corridor. La validation doit échouer ou réparer avant publication ; l’air diagonal ne suffit pas."
    },
    {
      "id": "F13-CRASH",
      "definition": "Stockage injectable à chaque écriture/manifeste/save. Source et cible ont des versions/hashes distinguables pour détecter les états mixtes."
    },
    {
      "id": "F14-EXISTING-BUILD",
      "definition": "Construction et inventaire témoins en sauvegarde de test ; comparés avant/après purge de caches, rechargement et exploration voisine."
    },
    {
      "id": "F15-NATIVE-MAPS",
      "definition": "Plaine rocheuse, arbre, mer, lac et grotte dans une fixture ; heightmaps attendues déterminées par scans à l’étape native appropriée."
    },
    {
      "id": "F16-PATTERN-CONTROLS",
      "definition": "Tuile répétée, hauteur en pavage hexagonal, cours d’eau de grille et cavernes en sphères identiques. Les détecteurs et la revue doivent identifier ces témoins négatifs."
    }
  ]
}
